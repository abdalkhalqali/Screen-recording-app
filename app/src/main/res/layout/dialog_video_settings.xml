<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- معدل الإطارات (Frame Rate) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🎞️ معدل الإطارات (Frame Rate)"
        android:textColor="#8899AA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnFrameRatePrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="السابق" />

        <TextView
            android:id="@+id/tvFrameRate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="30 fps - قياسي (افتراضي)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnFrameRateNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="التالي" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#206366F1"
        android:layout_marginTop="8dp" />

    <!-- جودة الفيديو (Bitrate) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="💎 جودة الفيديو (H.264 Bitrate)"
        android:textColor="#8899AA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnQualityPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="السابق" />

        <TextView
            android:id="@+id/tvVideoQuality"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="4 Mbps - عالي (افتراضي)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnVideoQualityNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="التالي" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#206366F1"
        android:layout_marginTop="8dp" />

    <!-- الفاصل الزمني للإطارات الرئيسية (I-Frame) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🔑 الإطارات الرئيسية (I-Frame)"
        android:textColor="#8899AA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnIFramePrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="السابق" />

        <TextView
            android:id="@+id/tvIFrame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1 ثانية (افتراضي)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnIFrameNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="التالي" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#206366F1"
        android:layout_marginTop="8dp" />

    <!-- بروفايل H.264 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🛡️ بروفايل H.264"
        android:textColor="#8899AA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnCodecPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="السابق" />

        <TextView
            android:id="@+id/tvCodec"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="High - جودة عالية (افتراضي)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCodecNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="التالي" />
    </LinearLayout>

</LinearLayout>
