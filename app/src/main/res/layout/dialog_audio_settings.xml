<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎚️ معدل العينة (Sample Rate)"
        android:textColor="#8899AA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnRatePrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="السابق" />

        <TextView
            android:id="@+id/tvSampleRate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="44.1 kHz - CD"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRateNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="التالي" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#206366F1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="🎧 جودة AAC (Bitrate)"
        android:textColor="#8899AA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnQualityPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="السابق" />

        <TextView
            android:id="@+id/tvQuality"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="128 kbps - عالي"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnQualityNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="التالي" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#206366F1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="🔇 كتم الضوضاء (Noise Suppression)"
        android:textColor="#8899AA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnNoisePrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="السابق" />

        <TextView
            android:id="@+id/tvNoise"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🚫 إيقاف"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNoiseNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/floating_button_bg"
            android:scaleType="center"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="التالي" />
    </LinearLayout>

</LinearLayout>
