<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="12dp"
    app:cardBackgroundColor="#E61A1A2E"
    app:cardCornerRadius="20dp"
    app:cardElevation="16dp"
    app:strokeColor="#606366F1"
    app:strokeWidth="1.5dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Recording indicator dot -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/recording_dot" />

        <!-- Timer -->
        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="monospace"
            android:text="00:00.0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="8dp"
            android:background="#306366F1" />

        <!-- Pause/Resume Button -->
        <ImageButton
            android:id="@+id/btnPauseResume"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/floating_button_bg"
            android:contentDescription="إيقاف مؤقت"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_pause" />

        <!-- Stop Button -->
        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/floating_button_bg_stop"
            android:contentDescription="إيقاف"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

        <!-- Drag handle indicator -->
        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/drag_handle"
            android:alpha="0.4" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
