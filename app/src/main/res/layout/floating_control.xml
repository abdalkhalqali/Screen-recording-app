<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/floating_bg"
    android:padding="8dp"
    android:elevation="10dp">

    <!-- عداد الوقت -->
    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginEnd="8dp"
        android:minWidth="50dp"
        android:gravity="center" />

    <!-- زر الإيقاف المؤقت/الاستئناف -->
    <ImageButton
        android:id="@+id/btnPauseResume"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_pause"
        android:background="@drawable/floating_btn_bg"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="إيقاف مؤقت" />

    <!-- زر الإيقاف -->
    <ImageButton
        android:id="@+id/btnStop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="@drawable/floating_btn_bg_stop"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:layout_marginStart="6dp"
        android:contentDescription="إيقاف" />

</LinearLayout>
